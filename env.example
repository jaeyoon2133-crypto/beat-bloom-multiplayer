# Metered TURN credential. Use the credential API key, not the account Secret Key.
METERED_DOMAIN=your-app-name.metered.live
METERED_TURN_API_KEY=paste-your-turn-credential-api-key-here
METERED_REGION=asia

# BeatBloom public room browser. Defaults to true; set false to disable room listing.
PEER_ALLOW_DISCOVERY=true

# Optional PeerJS server diagnostics
PEER_DEBUG=false
